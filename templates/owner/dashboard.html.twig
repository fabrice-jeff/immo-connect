{% extends 'base.html.twig' %}

{% block title %}ImmoConnect | Dashboard proprietaire{% endblock %}

{% block body %}
    <section class="bg-dark text-white py-5">
        <div class="container py-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="text-info text-uppercase fw-bold small">Espace proprietaire</span>
                    <h1 class="display-5 fw-bold mt-2 mb-3">Pilotez vos annonces, paiements et conversations</h1>
                    <p class="text-white-50 mb-0">Vue d ensemble du module de gestion demande dans le cahier de charge.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="{{ path('app_owner_publish') }}" class="btn btn-light btn-lg rounded-pill px-4">Nouvelle annonce</a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-4 mb-4">
                {% for metric in dashboard.metrics %}
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 metric-card">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="avatar-circle"><i class="bi {{ metric.icon }}"></i></span>
                                    <span class="badge text-bg-light border text-dark rounded-pill">Live</span>
                                </div>
                                <div class="display-6 fw-bold">{{ metric.value }}</div>
                                <div class="text-secondary">{{ metric.label }}</div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="row g-4">
                <div class="col-xl-7">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4 p-lg-5">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h2 class="h4 fw-bold mb-0">Portefeuille de biens</h2>
                                <a href="{{ path('app_property_index') }}" class="btn btn-sm btn-outline-primary rounded-pill">Voir le catalogue</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead><tr><th>Bien</th><th>Statut</th><th>Prix</th><th>Action</th></tr></thead>
                                    <tbody>
                                        {% for property in dashboard.portfolio %}
                                            <tr>
                                                <td><div class="fw-semibold">{{ property.title }}</div><div class="small text-secondary">{{ property.location }}</div></td>
                                                <td><span class="badge text-bg-success rounded-pill">{{ property.status }}</span></td>
                                                <td class="fw-bold">{{ property.price|number_format(0, ',', ' ') }} FCFA</td>
                                                <td><a class="btn btn-sm btn-primary rounded-pill" href="{{ path('app_property_show', {id: property.id}) }}">Ouvrir</a></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-lg-5">
                            <h2 class="h4 fw-bold mb-4">Messagerie interne</h2>
                            <div class="d-grid gap-3">
                                {% for message in dashboard.messages %}
                                    <div class="d-flex align-items-center justify-content-between gap-3 bg-light rounded-4 p-3">
                                        <div><div class="fw-bold">{{ message.from }}</div><div class="text-secondary">{{ message.subject }}</div></div>
                                        <span class="badge rounded-pill text-bg-light border text-dark">{{ message.time }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-5">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4 p-lg-5">
                            <h2 class="h4 fw-bold mb-4">Paiements et factures</h2>
                            <div class="d-grid gap-3">
                                {% for payment in dashboard.payments %}
                                    <div class="border rounded-4 p-3">
                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                            <div><div class="fw-semibold">{{ payment.label }}</div><div class="text-primary fw-bold">{{ payment.amount }}</div></div>
                                            <span class="badge {% if payment.status == 'Paye' %}text-bg-success{% elseif payment.status == 'En attente' %}text-bg-warning{% else %}text-bg-secondary{% endif %} rounded-pill">{{ payment.status }}</span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="alert alert-info rounded-4 border-0 mt-4 mb-0">Moyens de paiement prevus: MTN Money, Moov Money et virement bancaire.</div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-lg-5">
                            <h2 class="h4 fw-bold mb-4">Modules a brancher ensuite</h2>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0">Contrats de location et signature</li>
                                <li class="list-group-item px-0">Factures PDF telechargeables</li>
                                <li class="list-group-item px-0">Authentification email / SMS</li>
                                <li class="list-group-item px-0">Workflow de visite a distance</li>
                                <li class="list-group-item px-0">Trading et revente de biens a fort potentiel</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
