{% extends 'base.html.twig' %}

{% block title %}ImmoConnect | Accueil{% endblock %}

{% block body %}
    <section class="hero-surface text-white py-5 py-lg-6">
        <div class="container py-5">
            <div class="row align-items-center g-5 py-lg-4">
                <div class="col-lg-7">
                    <span class="badge text-bg-light text-primary rounded-pill px-3 py-2 mb-3">Plateforme immobiliere connectee</span>
                    <h1 class="display-4 fw-bold mb-4">Acheter, louer, publier et gerer vos biens depuis une seule application.</h1>
                    <p class="lead text-white-50 mb-4">
                        ImmoConnect relie acheteurs, proprietaires, locataires, colocataires et agences autour d une experience simple, rapide et rassurante.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="{{ path('app_property_index') }}" class="btn btn-light btn-lg rounded-pill px-4">Explorer les annonces</a>
                        <a href="{{ path('app_owner_publish') }}" class="btn btn-outline-light btn-lg rounded-pill px-4">Publier un bien</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="glass-panel rounded-5 shadow-lg p-4 p-lg-5 text-dark">
                        <h2 class="h4 fw-bold mb-4">Recherche rapide</h2>
                        <form action="{{ path('app_property_index') }}" method="get" class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Localisation</label>
                                <input class="form-control form-control-lg rounded-4" type="text" name="q" value="{{ filters.q }}" placeholder="Abidjan, Cocody, Plateau...">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Type de bien</label>
                                <select class="form-select form-select-lg rounded-4" name="category">
                                    <option value="">Tous</option>
                                    {% for item in page.categories %}
                                        <option value="{{ item.name }}" {% if filters.category == item.name %}selected{% endif %}>{{ item.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Operation</label>
                                <select class="form-select form-select-lg rounded-4" name="operation">
                                    <option value="">Toutes</option>
                                    <option value="A vendre" {% if filters.operation == 'A vendre' %}selected{% endif %}>A vendre</option>
                                    <option value="A louer" {% if filters.operation == 'A louer' %}selected{% endif %}>A louer</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Budget maximum</label>
                                <input class="form-control form-control-lg rounded-4" type="number" name="max_price" value="{{ filters.max_price }}" placeholder="Ex: 50000000">
                            </div>
                            <div class="col-12 d-grid">
                                <button class="btn btn-primary btn-lg rounded-pill">Lancer la recherche</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-4">
                {% for item in page.stats %}
                    <div class="col-6 col-lg-3">
                        <div class="metric-card rounded-4 shadow-sm p-4 h-100 border-0">
                            <div class="display-6 fw-bold text-primary mb-2">{{ item.value }}</div>
                            <div class="text-secondary">{{ item.label }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section-soft py-5">
        <div class="container">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
                <div>
                    <span class="text-primary text-uppercase fw-bold small">Types de biens</span>
                    <h2 class="display-6 fw-bold mt-2">Tous les espaces du cahier de charge sont representes</h2>
                </div>
                <a href="{{ path('app_property_index') }}" class="btn btn-outline-primary rounded-pill px-4">Voir tout le catalogue</a>
            </div>
            <div class="row g-4">
                {% for item in page.categories %}
                    <div class="col-md-6 col-xl-4">
                        <div class="card card-lift border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-4" style="width: 4rem; height: 4rem;">
                                    <i class="bi {{ item.icon }} fs-3"></i>
                                </div>
                                <h3 class="h4 fw-bold">{{ item.name }}</h3>
                                <p class="text-secondary mb-0">{{ item.description }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <span class="text-primary text-uppercase fw-bold small">Services</span>
                <h2 class="display-6 fw-bold mt-2">Un parcours digital pour chaque acteur du marche</h2>
            </div>
            <div class="row g-4">
                {% for item in page.services %}
                    <div class="col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 hover-rise">
                            <div class="card-body p-4">
                                <div class="avatar-circle mb-4"><i class="bi {{ item.icon }}"></i></div>
                                <h3 class="h5 fw-bold">{{ item.title }}</h3>
                                <p class="text-secondary mb-0">{{ item.description }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="py-5 section-soft">
        <div class="container">
            <div class="row align-items-center g-4 mb-4">
                <div class="col-lg-8">
                    <span class="text-primary text-uppercase fw-bold small">Annonces recentes</span>
                    <h2 class="display-6 fw-bold mt-2">Des opportunites pour la location, l achat et la revente</h2>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="{{ path('app_property_index') }}" class="btn btn-primary rounded-pill px-4">Tout voir</a>
                </div>
            </div>
            <div class="row g-4">
                {% for property in page.latest %}
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 card-lift overflow-hidden">
                            <img src="{{ property.images[0] }}" class="card-img-top" alt="{{ property.title }}" style="height: 240px; object-fit: cover;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                                    <span class="badge text-bg-primary rounded-pill px-3 py-2">{{ property.operation }}</span>
                                    <span class="fw-bold text-primary">{{ property.price|number_format(0, ',', ' ') }} FCFA</span>
                                </div>
                                <h3 class="h5 fw-bold">{{ property.title }}</h3>
                                <p class="text-secondary mb-3"><i class="bi bi-geo-alt me-2"></i>{{ property.location }}</p>
                                <div class="d-flex flex-wrap gap-3 text-secondary small mb-4">
                                    <span><i class="bi bi-door-open me-1"></i>{{ property.rooms }} pieces</span>
                                    <span><i class="bi bi-badge-wc me-1"></i>{{ property.bathrooms }} sdb</span>
                                    <span><i class="bi bi-arrows-angle-expand me-1"></i>{{ property.surface }} m2</span>
                                </div>
                                <a href="{{ path('app_property_show', {id: property.id}) }}" class="btn btn-outline-primary rounded-pill">Voir le detail</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% if search_preview is not empty and (filters.q or filters.category or filters.operation or filters.max_price) %}
        <section class="py-5 bg-white">
            <div class="container">
                <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4">
                    <strong>Resultat instantane:</strong> voici quelques biens correspondant a votre recherche.
                </div>
                <div class="row g-4">
                    {% for property in search_preview %}
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <img src="{{ property.images[0] }}" class="card-img-top" alt="{{ property.title }}" style="height: 220px; object-fit: cover;">
                                <div class="card-body">
                                    <h3 class="h5 fw-bold">{{ property.title }}</h3>
                                    <p class="text-secondary">{{ property.location }}</p>
                                    <a class="btn btn-sm btn-primary rounded-pill" href="{{ path('app_property_show', {id: property.id}) }}">Consulter</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="py-5 bg-dark text-white">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <span class="text-info text-uppercase fw-bold small">Gestion proprietaire</span>
                    <h2 class="display-6 fw-bold mt-2">Messagerie, paiements, contrats et visites en un seul dashboard</h2>
                    <p class="text-white-50">
                        Le MVP inclut deja un espace proprietaire Bootstrap pour suivre les annonces, les paiements, les demandes et les rendez-vous.
                    </p>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <a href="{{ path('app_owner_dashboard') }}" class="btn btn-light btn-lg rounded-pill px-4">Ouvrir le dashboard</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
