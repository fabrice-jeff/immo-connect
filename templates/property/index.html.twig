{% extends 'base.html.twig' %}

{% block title %}ImmoConnect | Proprietes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .price-stack {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-end;
            gap: .2rem;
            background: linear-gradient(180deg, rgba(13, 110, 253, .08), rgba(13, 110, 253, .02));
            border: 1px solid rgba(13, 110, 253, .12);
            border-radius: 1.25rem;
            padding: .85rem 1rem;
            min-width: 185px;
        }

        .price-stack-label {
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #6b7280;
        }

        .price-stack-value {
            font-size: clamp(1.35rem, 2vw, 2rem);
            line-height: 1;
            letter-spacing: -.04em;
            color: #0d6efd;
            white-space: nowrap;
        }

        .price-stack-currency {
            font-size: .88rem;
            font-weight: 700;
            color: #475569;
            letter-spacing: .06em;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="bg-dark text-white py-5">
        <div class="container py-4">
            <p class="text-primary text-uppercase fw-bold small mb-2">Catalogue immobilier</p>
            <h1 class="display-5 fw-bold mb-3">Trouvez le bon bien selon votre besoin</h1>
            <p class="text-white-50 mb-0">
                Filtrez par zone, budget, type de bien, nombre de pieces et mode d acquisition.
            </p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h2 class="h4 fw-bold mb-4">Filtres</h2>
                            <form method="get" class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Recherche</label>
                                    <input type="text" class="form-control rounded-4" name="q" value="{{ filters.q }}" placeholder="Ville, quartier ou mot cle">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Type de bien</label>
                                    <select class="form-select rounded-4" name="category">
                                        <option value="">Tous les types</option>
                                        {% for category in categories %}
                                            <option value="{{ category }}" {% if filters.category == category %}selected{% endif %}>{{ category }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Operation</label>
                                    <select class="form-select rounded-4" name="operation">
                                        <option value="">Toutes</option>
                                        {% for operation in operations %}
                                            <option value="{{ operation }}" {% if filters.operation == operation %}selected{% endif %}>{{ operation }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Pieces minimum</label>
                                    <select class="form-select rounded-4" name="rooms">
                                        <option value="0">Sans minimum</option>
                                        {% for room in 1..6 %}
                                            <option value="{{ room }}" {% if filters.rooms == room %}selected{% endif %}>{{ room }}+</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Budget maximum</label>
                                    <input type="number" class="form-control rounded-4" name="max_price" value="{{ filters.max_price }}" placeholder="Ex: 1000000">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Trier par</label>
                                    <select class="form-select rounded-4" name="sort">
                                        <option value="recent" {% if filters.sort == 'recent' %}selected{% endif %}>Plus recents</option>
                                        <option value="price_asc" {% if filters.sort == 'price_asc' %}selected{% endif %}>Prix croissant</option>
                                        <option value="price_desc" {% if filters.sort == 'price_desc' %}selected{% endif %}>Prix decroissant</option>
                                        <option value="surface_desc" {% if filters.sort == 'surface_desc' %}selected{% endif %}>Surface la plus grande</option>
                                    </select>
                                </div>
                                <div class="col-12 d-grid gap-2">
                                    <button class="btn btn-primary rounded-pill">Filtrer les resultats</button>
                                    <a class="btn btn-outline-secondary rounded-pill" href="{{ path('app_property_index') }}">Reinitialiser</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8 col-xl-9">
                    {% if properties is empty %}
                        <div class="alert alert-warning rounded-4 border-0 shadow-sm">
                            Aucun bien ne correspond a ces criteres pour le moment.
                        </div>
                    {% endif %}

                    <div class="row g-4">
                        {% for property in properties %}
                            <div class="col-12">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden hover-rise">
                                    <div class="row g-0">
                                        <div class="col-md-4">
                                            <img src="{{ property.images[0] }}" class="img-fluid h-100 w-100" alt="{{ property.title }}" style="object-fit: cover; min-height: 280px;">
                                        </div>
                                        <div class="col-md-8">
                                            <div class="card-body p-4 p-lg-5">
                                                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                                                    <div>
                                                        <span class="badge text-bg-primary rounded-pill px-3 py-2 mb-2">{{ property.operation }}</span>
                                                        <h2 class="h3 fw-bold mb-2">{{ property.title }}</h2>
                                                        <p class="text-secondary mb-0"><i class="bi bi-geo-alt me-2"></i>{{ property.location }}</p>
                                                    </div>
                                                    <div class="text-lg-end">
                                                        <div class="price-stack">
                                                            <span class="price-stack-label">Prix</span>
                                                            <span class="price-stack-value">{{ property.price|number_format(0, ',', ' ') }}</span>
                                                            <span class="price-stack-currency">FCFA</span>
                                                        </div>
                                                        <span class="badge rounded-pill text-bg-light border text-dark">{{ property.category }}</span>
                                                    </div>
                                                </div>
                                                <p class="text-secondary mb-4">{{ property.excerpt }}</p>
                                                <div class="d-flex flex-wrap gap-4 text-secondary mb-4">
                                                    <span><i class="bi bi-door-open me-1"></i>{{ property.rooms }} pieces</span>
                                                    <span><i class="bi bi-droplet-half me-1"></i>{{ property.bathrooms }} salles d eau</span>
                                                    <span><i class="bi bi-arrows-angle-expand me-1"></i>{{ property.surface }} m2</span>
                                                    <span><i class="bi bi-patch-check me-1"></i>{{ property.status }}</span>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a href="{{ path('app_property_show', {id: property.id}) }}" class="btn btn-primary rounded-pill px-4">Voir les details</a>
                                                    <a href="{{ path('app_owner_dashboard') }}" class="btn btn-outline-primary rounded-pill px-4">Contacter via messagerie</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
