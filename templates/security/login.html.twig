{% extends 'base.html.twig' %}

{% block title %}ImmoConnect | Connexion{% endblock %}

{% set show_nav = false %}
{% set show_footer = false %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-page {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(13, 110, 253, .10), transparent 30%),
                linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%);
        }

        .auth-left,
        .auth-right {
            min-height: 100vh;
        }

        .auth-left {
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(14px);
        }

        .auth-shell {
            width: 100%;
            max-width: 430px;
        }

        .auth-brand {
            color: #0b1736;
            letter-spacing: -.03em;
        }

        .auth-kicker {
            letter-spacing: .14em;
            text-transform: uppercase;
            font-size: .72rem;
            font-weight: 800;
            color: #0d6efd;
        }

        .auth-title {
            font-size: clamp(1.7rem, 2.6vw, 2.6rem);
            line-height: .98;
            letter-spacing: -.05em;
        }

        .auth-copy {
            color: #6b7280;
            font-size: .95rem;
        }

        .auth-card {
            border: 1px solid rgba(148, 163, 184, .18);
            border-radius: 1.5rem;
            box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, .08);
            background: rgba(255, 255, 255, .92);
        }

        .auth-input {
            border-radius: .9rem;
            padding: .78rem .95rem;
            border-color: #dbe3f0;
        }

        .auth-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .14);
        }

        .auth-btn {
            border-radius: .9rem;
            padding: .8rem 1rem;
            font-weight: 800;
            box-shadow: 0 .6rem 1.2rem rgba(13, 110, 253, .18);
        }

        .social-btn {
            width: 48px;
            height: 48px;
            border-radius: .9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .auth-right {
            position: relative;
            background:
                linear-gradient(180deg, rgba(13, 110, 253, .92), rgba(11, 23, 54, .96)),
                radial-gradient(circle at top right, rgba(255, 255, 255, .20), transparent 35%);
        }

        .auth-right::after {
            content: "";
            position: absolute;
            inset: auto 6% 0 auto;
            width: min(70%, 540px);
            height: 68%;
            background: url('https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?auto=format&fit=crop&w=1100&q=80') center bottom / contain no-repeat;
            pointer-events: none;
        }

        .quote-box {
            max-width: 33rem;
            position: relative;
            z-index: 1;
        }

        .quote-box blockquote {
            font-size: clamp(1.45rem, 2.2vw, 2.25rem);
            line-height: 1.02;
            letter-spacing: -.05em;
        }

        .quote-box p {
            font-size: .95rem;
            color: rgba(17, 24, 39, .78);
        }

        @media (max-width: 991.98px) {
            .auth-page,
            .auth-left,
            .auth-right {
                min-height: auto;
            }

            .auth-right {
                display: none !important;
            }

            .auth-left {
                min-height: 100vh;
            }

            .auth-shell {
                max-width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="container-fluid auth-page">
        <div class="row g-0 h-100">
            <div class="col-lg-5 d-flex auth-left">
                <div class="w-100 d-flex flex-column px-4 px-xl-4 py-3">
                    <div class="mb-3">
                        <a href="{{ path('app_home') }}" class="text-decoration-none auth-brand fw-bold fs-2 d-inline-flex align-items-center gap-3">
                            <span class="navbar-brand-mark"><i class="bi bi-house-door-fill"></i></span>
                            <span>ImmoConnect</span>
                        </a>
                    </div>

                    <div class="flex-grow-1 d-flex align-items-center">
                        <div class="auth-shell mx-auto">
                            <div class="mb-3">
                                <div class="auth-kicker mb-2">Connexion</div>
                                <h1 class="auth-title fw-bold mb-2">Retrouvez vos opportunites immobilieres.</h1>
                                <p class="auth-copy mb-0">Connectez-vous pour suivre vos annonces, vos demandes et vos visites en quelques secondes.</p>
                            </div>

                            <div class="auth-card p-3 p-xl-4">
                                <form method="post" class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small mb-1">Email ou numero</label>
                                        <input type="text" class="form-control auth-input" name="identifier" placeholder="vous@email.com ou +225 ...">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small mb-1">Mot de passe</label>
                                        <input type="password" class="form-control auth-input" name="password" placeholder="Votre mot de passe">
                                    </div>
                                    <div class="col-12 d-flex justify-content-between align-items-center small">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="checkbox" id="rememberMe">
                                            <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                                        </div>
                                        <a href="{{ path('app_register') }}" class="text-decoration-none">Creer un compte</a>
                                    </div>
                                    <div class="col-12 d-grid">
                                        <button class="btn btn-primary auth-btn">Se connecter</button>
                                    </div>
                                </form>

                                <div class="d-flex align-items-center my-2 text-secondary small">
                                    <div class="flex-grow-1 border-top"></div>
                                    <span class="px-3">ou continuer avec</span>
                                    <div class="flex-grow-1 border-top"></div>
                                </div>

                                <div class="d-flex justify-content-center gap-3">
                                    <button type="button" class="btn btn-outline-secondary social-btn"><i class="bi bi-google fs-5"></i></button>
                                    <button type="button" class="btn btn-outline-secondary social-btn"><i class="bi bi-facebook fs-5"></i></button>
                                    <button type="button" class="btn btn-outline-secondary social-btn"><i class="bi bi-apple fs-5"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 d-none d-lg-flex auth-right align-items-center">
                <div class="quote-box px-4 px-xl-5 ms-2">
                    <div class="auth-kicker text-white mb-2">Experience utilisateur</div>
                    <blockquote class="fw-bold text-white mb-2">
                        "Avec ImmoConnect, la bonne location ou le bon terrain arrive plus vite et avec moins de stress."
                    </blockquote>
                    <p class="mb-0 fw-semibold text-white-50">Une interface pensee pour les locataires, acheteurs, proprietaires et agences.</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
